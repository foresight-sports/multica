{
    admin off
    auto_https off
}

:80 {
    # Open the self-hosted app when visitors enter the bare hostname.
    redir / /login 302

    # Cloudflare terminates public HTTPS; this listener is the private origin.
    @backend path /health /readyz /ws /ws/* /api/daemon/ws
    handle @backend {
        reverse_proxy backend:8080 {
            header_up X-Forwarded-Proto https
            flush_interval -1
        }
    }

    handle {
        reverse_proxy frontend:3000 {
            header_up X-Forwarded-Proto https
        }
    }
}
